// ============================================================

model FinancialMoneyIn {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  accountId String

  account FinancialAccount @relation(fields: [accountId], references: [id])

  transactionId String @unique

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id])

  method FinancialMoneyInMethod

  amount   Int
  currency String @default("KES")

  externalReference String?

  status FinancialMoneyInStatus @default(PENDING)

  initiatedAt DateTime  @default(now())
  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([externalReference])
  @@index([initiatedAt])
}

// ============================================================
// MONEY OUT
// ============================================================

model FinancialMoneyOut {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  accountId String

  account FinancialAccount @relation(fields: [accountId], references: [id])

  transactionId String @unique

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id])

  method FinancialMoneyOutMethod

  destinationPublicId String

  amount    Int
  feeAmount Int @default(0)
