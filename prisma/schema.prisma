  commissionRuleId String

  commissionRule CommercialCommissionRule @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)

  // ---------------------------------------------------------------------------
  // Commission assessment snapshot
  // ---------------------------------------------------------------------------

  /// Snapshot of the commission percentage used for this settlement.
  percentage Decimal @db.Decimal(5, 2)

