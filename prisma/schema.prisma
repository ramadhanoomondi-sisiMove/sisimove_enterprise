// =============================================================================
// COMMERCIAL BOOKING COMMISSION
// =============================================================================

model CommercialBookingCommission {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Cross-domain references
  // ---------------------------------------------------------------------------

  /// References JourneyBooking.publicId.
  /// Intentionally NOT a Prisma relation.
  bookingPublicId String @unique

  /// References Journey.publicId.
  /// Intentionally NOT a Prisma relation.
  journeyPublicId String

  // ---------------------------------------------------------------------------
  // Commission rule
  // ---------------------------------------------------------------------------

  /// References CommercialCommissionRule.id.
  /// Internal Commercial-domain relation.
  commissionRuleId String

  commissionRule CommercialCommissionRule @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)

  // ---------------------------------------------------------------------------
  // Commission assessment snapshot
  // ---------------------------------------------------------------------------

  /// Snapshot of the commission percentage used for this booking.
  percentage Decimal @db.Decimal(5, 2)

  /// Booking amount before the Commercial booking commission.
  ///
  /// This is derived from the JourneyBookingPricing amount used
  /// as the commercial commission base.
  baseAmount Int

  /// Commission charged to the passenger.
  ///
  /// Example:
  /// baseAmount = 1000
  /// percentage = 5.00
  /// commissionAmount = 50
  ///
  /// The resulting passenger payment amount is:
  ///
  /// 1000 + 50 = 1050
  ///
  /// The final payment amount belongs to JourneyBookingPayment,
  /// not to CommercialBookingCommission.
  commissionAmount Int

  currency String @default("KES")

  // ---------------------------------------------------------------------------
  // Lifecycle
  // ---------------------------------------------------------------------------

  status CommercialCommissionStatus @default(PENDING)

  assessedAt  DateTime?
  cancelledAt DateTime?

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([journeyPublicId])
  @@index([commissionRuleId])
  @@index([status])
  @@index([assessedAt])
  @@map("commercial_booking_commissions")
}

