  /// Intentionally NOT a Prisma relation.
  settlementPublicId String @unique

  /// References Identity.publicId.
  /// Intentionally NOT a Prisma relation.
  providerPublicId String

  // ---------------------------------------------------------------------------
  // Commission rule
  // ---------------------------------------------------------------------------

  /// References CommercialCommissionRule.id.
  /// Internal Commercial-domain relation.
  commissionRuleId String

  commissionRule CommercialCommissionRule @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)

  // ---------------------------------------------------------------------------
  // Commission assessment snapshot
  // ---------------------------------------------------------------------------

  /// Snapshot of the commission percentage used for this settlement.
  percentage Decimal @db.Decimal(5, 2)

  /// Provider earning before the Commercial earning commission.
  ///
  /// This amount is derived from the Journey/Financial settlement
  /// process and is not owned by Commercial.
  baseAmount Int

  /// Commission retained by the platform from the provider earning.
  commissionAmount Int

