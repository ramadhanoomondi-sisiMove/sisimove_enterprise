generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Identity {
  id       String @id @default(uuid())
  publicId String @unique

  email       String         @unique
  phoneNumber String?        @unique
  type        IdentityType
  status      IdentityStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activatedAt DateTime?
  suspendedAt DateTime?
  closedAt    DateTime?

  authentication      Authentication?
  verification        Verification?   @relation("IdentityVerification")
  verificationReviews Verification[]  @relation("VerificationReviewer")

  sessions   Session[]
  devices    Device[]
  recoveries Recovery[]
  assets     Asset[]

  identityRoles IdentityRole[]

  roleAssignmentsMade IdentityRole[] @relation("RoleAssignments")
  roleRevocationsMade IdentityRole[] @relation("RoleRevocations")

  auditEvents          IdentityAudit[]
  auditActions         IdentityAudit[]       @relation("AuditActor")
  verificationRequests VerificationRequest[]
  assetModerations     AssetModeration[]

  @@index([email])
  @@index([phoneNumber])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("identities")
}

model Authentication {
  id       String @id @default(uuid())
  publicId String @unique

  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  status AuthenticationStatus

  passwordHash    String?
  passwordVersion Int     @default(1)

  passwordChangedAt  DateTime?
  passwordExpiresAt  DateTime?
  passwordMustChange Boolean   @default(false)

  failedAuthenticationCount  Int       @default(0)
  lastFailedAuthenticationAt DateTime?

  lockedAt    DateTime?
  lockedUntil DateTime?
  lockReason  AuthenticationFailureReason?

  lastAuthenticatedAt DateTime?

  mfaStatus    MfaStatus
  mfaMethod    AuthenticationMfaMethod?
  mfaSecret    String?
  mfaEnabledAt DateTime?

  passwordHistories PasswordHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identityId])
  @@index([status])
  @@index([lockedUntil])
  @@index([lastAuthenticatedAt])
  @@map("authentications")
}

model PasswordHistory {
  id String @id @default(uuid())

  authenticationId String
  authentication   Authentication @relation(fields: [authenticationId], references: [id], onDelete: Cascade)

  passwordHash String

  version Int

  createdAt DateTime @default(now())

  @@unique([authenticationId, version])
  @@index([authenticationId])
  @@index([createdAt])
  @@map("password_histories")
}

model Role {
  id       String @id @default(uuid())
  publicId String @unique

  name String @unique
  code String @unique

  description  String?
  displayOrder Int     @default(0)

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  identityRoles   IdentityRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  publicId String @unique

  name String
  code String @unique

  resource String
  action   String

  description String?

  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
  @@index([isActive])
  @@map("permissions")
}

model RolePermission {
  id String @id @default(uuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model IdentityRole {
  id String @id @default(uuid())

  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedById String?
  assignedBy   Identity? @relation("RoleAssignments", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now())

  expiresAt DateTime?

  revokedAt   DateTime?
  revokedById String?
  revokedBy   Identity? @relation("RoleRevocations", fields: [revokedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identityId, roleId])
  @@index([identityId])
  @@index([roleId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("identity_roles")
}

model Session {
  id       String @id @default(uuid())
  publicId String @unique

  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  status SessionStatus

  refreshTokenHash String @unique

  ipAddress   String?
  userAgent   String?
  countryCode String? @db.VarChar(2)
  city        String?

  authenticatedAt DateTime
  lastActivityAt  DateTime

  expiresAt DateTime

  revokedAt     DateTime?
  revokedReason SessionRevocationReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identityId])
  @@index([deviceId])
  @@index([status])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("sessions")
}

model Device {
  id       String @id @default(uuid())
  publicId String @unique

  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  status     DeviceStatus
  trustLevel DeviceTrustLevel

  fingerprint String @unique

  name                   String?
  platform               String?
  operatingSystem        String?
  operatingSystemVersion String?
  browser                String?
  browserVersion         String?
  deviceType             DeviceType

  trustedAt  DateTime?
  lastSeenAt DateTime?

  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  @@index([identityId])
  @@index([status])
  @@index([trustLevel])
  @@index([lastSeenAt])
  @@map("devices")
}

model Verification {
  id       String @id @default(uuid())
  publicId String @unique

  identityId String   @unique
  identity   Identity @relation("IdentityVerification", fields: [identityId], references: [id], onDelete: Cascade)

  status VerificationStatus
  level  VerificationLevel

  profilePhotoVerified  Boolean @default(false)
  governmentIdVerified  Boolean @default(false)
  driverLicenseVerified Boolean @default(false)

  verifiedAt DateTime?
  expiresAt  DateTime?

  reviewedById String?
  reviewedBy   Identity? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason String?
  lastReviewedAt  DateTime?

  requests VerificationRequest[]

  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  memberVerifiedAt DateTime?
  decisionReason   VerificationDecisionReason?

  driverVerifiedAt DateTime?

  profilePhotoVerifiedAt DateTime?

  governmentIdVerifiedAt DateTime?

  driverLicenseVerifiedAt DateTime?

  @@index([identityId])
  @@index([reviewedById])
  @@index([status])
  @@index([level])
  @@index([expiresAt])
  @@map("verifications")
}

model VerificationRequest {
  id       String @id @default(uuid())
  publicId String @unique

  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  type VerificationRequestType

  status VerificationRequestStatus

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  submittedAt DateTime @default(now())

  reviewedAt DateTime?

  reviewedById String?
  reviewedBy   Identity? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason String?
  expiresAt       DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationId])
  @@index([type])
  @@index([status])
  @@map("verification_requests")
}

model Recovery {
  id       String @id @default(uuid())
  publicId String @unique

  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  type   RecoveryType
  status RecoveryStatus

  recoveryTokenHash String? @unique

  requestedAt DateTime
  expiresAt   DateTime

  completedAt DateTime?
  cancelledAt DateTime?

  failureReason RecoveryFailureReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identityId])
  @@index([expiresAt])
  @@index([requestedAt])
  @@index([identityId, type])
  @@index([identityId, status])
  @@map("recoveries")
}

model IdentityAudit {
  id         String    @id @default(uuid())
  publicId   String    @unique
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  actorIdentityId String?
  actorIdentity   Identity? @relation("AuditActor", fields: [actorIdentityId], references: [id], onDelete: SetNull)

  actorType AuditActorType

  eventType IdentityAuditEventType
  severity  AuditSeverity
  result    AuditResult

  resourceType     AuditResourceType
  resourcePublicId String?

  correlationId String?

  ipAddress String?
  userAgent String?

  metadata Json?

  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([identityId])
  @@index([actorIdentityId])
  @@index([eventType])
  @@index([severity])
  @@index([result])
  @@index([resourceType])
  @@index([resourcePublicId])
  @@index([correlationId])
  @@index([occurredAt])
  @@map("identity_audits")
}

model Asset {
  id       String @id @default(uuid())
  publicId String @unique

  ownerIdentityId String?
  ownerIdentity   Identity? @relation(fields: [ownerIdentityId], references: [id], onDelete: SetNull)

  type       AssetType
  category   AssetCategory
  status     AssetStatus     @default(UPLOADING)
  visibility AssetVisibility @default(PRIVATE)

  storageProvider StorageProvider

  bucket    String
  objectKey String @unique

  originalFilename String?
  storedFilename   String?

  mimeType  String
  extension String?

  sizeBytes BigInt

  checksumAlgorithm ChecksumAlgorithm?
  checksum          String?

  width      Int?
  height     Int?
  colorDepth Int?

  durationSeconds Int?
  bitrate         Int?
  frameRate       Float?

  blurHash String?

  metadata Json?

  uploadedAt DateTime?

  archivedAt DateTime?
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants AssetVariant[]

  references  AssetReference[]
  processings AssetProcessing[]
  scans       AssetScan[]
  moderations AssetModeration[]

  verificationRequests VerificationRequest[]

  @@index([ownerIdentityId])
  @@index([type])
  @@index([category])
  @@index([status])
  @@index([visibility])
  @@index([storageProvider])
  @@index([uploadedAt])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([ownerIdentityId, status])
  @@index([ownerIdentityId, category])
  @@index([storageProvider, status])
  @@index([type, status])
  @@index([category, status])
  @@index([visibility, status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([ownerIdentityId, createdAt])
  @@index([ownerIdentityId, visibility])
  @@map("assets")
}

model AssetVariant {
  id       String @id @default(uuid())
  publicId String @unique

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  variant AssetVariantType

  status AssetVariantStatus @default(PENDING)

  isGenerated Boolean @default(true)

  storageProvider StorageProvider

  bucket    String
  objectKey String @unique

  mimeType  String
  extension String?

  sizeBytes BigInt

  width  Int?
  height Int?

  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assetId, variant])
  @@index([assetId])
  @@index([status])
  @@index([variant])
  @@index([assetId, status])
  @@index([storageProvider])
  @@index([createdAt])
  @@map("asset_variants")
}

model AssetReference {
  id       String @id @default(uuid())
  publicId String @unique

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  resourceType AssetResourceType

  resourcePublicId String

  referenceField AssetReferenceField

  createdAt DateTime @default(now())

  @@unique([assetId, resourceType, resourcePublicId, referenceField])
  @@index([assetId])
  @@index([resourceType])
  @@index([resourcePublicId])
  @@index([resourceType, resourcePublicId])
  @@map("asset_references")
}

model AssetProcessing {
  id       String @id @default(uuid())
  publicId String @unique

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  operation AssetProcessingOperation

  status AssetProcessingStatus @default(PENDING)

  processor AssetProcessor?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  failureReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([operation])
  @@index([createdAt])
  @@index([assetId, operation])
  @@index([assetId, status])
  @@index([processor])
  @@index([startedAt])
  @@index([completedAt])
  @@index([failedAt])
  @@map("asset_processings")
}

model AssetScan {
  id       String @id @default(uuid())
  publicId String @unique

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  engine AssetScanEngine

  status AssetScanStatus @default(PENDING)

  scannedAt DateTime?

  threatName String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([engine])
  @@index([scannedAt])
  @@index([assetId, engine])
  @@index([assetId, status])
  @@index([createdAt])
  @@map("asset_scans")
}

model AssetModeration {
  id       String @id @default(uuid())
  publicId String @unique

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  type AssetModerationType

  status AssetModerationStatus @default(PENDING)

  moderatorIdentityId String?
  moderatorIdentity   Identity? @relation(fields: [moderatorIdentityId], references: [id], onDelete: SetNull)

  confidence Float?

  reason String?

  metadata Json?

  moderatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([type])
  @@index([moderatorIdentityId])
  @@index([assetId, type])
  @@index([assetId, status])
  @@index([moderatedAt])
  @@index([createdAt])
  @@map("asset_moderations")
}

