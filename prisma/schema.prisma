  // ---------------------------------------------------------------------------

  bookingId String @unique

  booking JourneyBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Journey snapshot
  //
  // This represents the state of the journey at booking time.
  // It intentionally does NOT reference JourneyCorridor or JourneySchedule.
  // ---------------------------------------------------------------------------

  originName      String
  destinationName String

  originLatitude  Decimal @db.Decimal(10, 7)
  originLongitude Decimal @db.Decimal(10, 7)

  destinationLatitude  Decimal @db.Decimal(10, 7)
  destinationLongitude Decimal @db.Decimal(10, 7)

  departureAt DateTime
  arrivalAt   DateTime?

  timezone String @default("Africa/Nairobi")

  // ---------------------------------------------------------------------------
  // Vehicle snapshot
  // ---------------------------------------------------------------------------

  vehicleMake         String?
  vehicleModel        String?
  vehicleYear         Int?
  vehicleColor        String?
  vehicleRegistration String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("journey_booking_snapshots")
}

