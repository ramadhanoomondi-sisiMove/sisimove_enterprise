  // ---------------------------------------------------------------------------
  // Internal Journey-domain relation
  // ---------------------------------------------------------------------------

  completionId String @unique

  completion JourneyCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Cross-domain references
  // ---------------------------------------------------------------------------

  /// References Journey.publicId.
  /// Intentionally NOT a Prisma relation.
  journeyPublicId String

  /// References Identity.publicId.
  /// Intentionally NOT a Prisma relation.
  providerPublicId String

  // ---------------------------------------------------------------------------
  // Settlement lifecycle
  // ---------------------------------------------------------------------------

  status JourneySettlementStatus @default(PENDING)

  /// References the Financial domain.
  /// Intentionally NOT a Prisma relation.
  financialTransactionPublicId String?

  submittedAt  DateTime?
  processingAt DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  heldAt       DateTime?
  cancelledAt  DateTime?

  failureReason String?

  // ---------------------------------------------------------------------------
  // Aggregate version
  // ---------------------------------------------------------------------------

  version Int @default(1)

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([journeyPublicId])
  @@index([providerPublicId])
  @@index([status])
  @@index([status, createdAt])
  @@index([financialTransactionPublicId])
  @@map("journey_settlements")
}

// ---------------------------------------------------------------------------
// Message Domain
// -----------------------------------------------------------

model MessagingConversation {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  type   MessagingConversationType
  status MessagingConversationStatus @default(ACTIVE)

  journeyPublicId String
  bookingPublicId String?

  participants MessagingConversationParticipant[]
  messages     MessagingMessage[]

  lastMessageAt DateTime?
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyPublicId])
  @@index([bookingPublicId])
  @@index([status])
  @@index([journeyPublicId, status])
}

model MessagingConversationParticipant {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  conversationId String
  conversation   MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  memberPublicId String

  role   MessagingParticipantRole
  status MessagingParticipantStatus @default(ACTIVE)

  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  removedAt  DateTime?
  lastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, memberPublicId])
  @@index([conversationId])
  @@index([memberPublicId])
  @@index([memberPublicId, status])
  @@index([conversationId, status])
}

model MessagingMessage {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  conversationId String
  conversation   MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderPublicId String

  type   MessagingMessageType
  status MessagingMessageStatus @default(SENT)

  content String?
  assetId String?

  sentAt      DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?
  moderatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderPublicId])
  @@index([conversationId, sentAt])
  @@index([status])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  recipientPublicId String

  type     NotificationType
  priority NotificationPriority @default(NORMAL)
  status   NotificationStatus   @default(PENDING)

  title String
  body  String

  referenceType     String?
  referencePublicId String?

  eventType     String?
  eventPublicId String?

  sentAt      DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  failureReason String?

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientPublicId])
  @@index([recipientPublicId, status])
  @@index([recipientPublicId, createdAt])
  @@index([type])
  @@index([priority])
  @@index([eventType, eventPublicId])
}

// ============================================================
// NOTIFICATION PREFERENCE
