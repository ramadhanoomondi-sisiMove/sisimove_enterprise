  ///
  /// Examples:
  /// - Journey
  /// - JourneyBooking
  /// - JourneyCompletion
  /// - JourneyCompletionDispute
  /// - FinancialPayment
  /// - SupportCase
  ///
  /// Intentionally NOT a Prisma relation.
  referenceType     String?
  referencePublicId String?

  // ---------------------------------------------------------------------------
  // Source event
  // ---------------------------------------------------------------------------

  /// Event that caused this notification.
  ///
  /// Intentionally stored as scalar metadata rather than a Prisma relation.
  eventType     String?
  eventPublicId String?

  // ---------------------------------------------------------------------------
  // Delivery lifecycle
  // ---------------------------------------------------------------------------

  sentAt      DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  failureReason String?

  // ---------------------------------------------------------------------------
  // Deliveries
  // ---------------------------------------------------------------------------

  deliveries NotificationDelivery[]

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([recipientPublicId])
  @@index([recipientPublicId, status])
  @@index([recipientPublicId, createdAt])
  @@index([type])
  @@index([priority])
  @@index([eventType, eventPublicId])
  @@index([referenceType, referencePublicId])
  @@map("notifications")
}

