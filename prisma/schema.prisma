generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// IDENTITY
// =============================================================================

model Identity {
  id       String @id @default(uuid())
  publicId String @unique

  email       String @unique
  phoneNumber String @unique

  status IdentityStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activatedAt DateTime?
  suspendedAt DateTime?
  closedAt    DateTime?

  // ---------------------------------------------------------------------------
  // Verification
  // ---------------------------------------------------------------------------

  verification Verification? @relation("IdentityVerification")

  // Verification reviews performed by this identity.
  verificationReviews Verification[] @relation("VerificationReviewer")

  // Verification requests reviewed by this identity.
  verificationRequestsReviewed VerificationRequest[] @relation("VerificationRequestReviewer")

  // ---------------------------------------------------------------------------
  // Authorization
  // ---------------------------------------------------------------------------

  identityRoles IdentityRole[]

  // Roles assigned by this identity.
  roleAssignmentsMade IdentityRole[] @relation("RoleAssignments")

  // Roles revoked by this identity.
  roleRevocationsMade IdentityRole[] @relation("RoleRevocations")

  // ---------------------------------------------------------------------------
  // Asset Domain Relationships
  // ---------------------------------------------------------------------------

  // Assets owned by this identity.
  ownedAssets Asset[]

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([status])
  @@index([createdAt])
  @@map("identities")
}

// =============================================================================
// VERIFICATION
// =============================================================================

model Verification {
  id       String @id @default(uuid())
  publicId String @unique

  // ---------------------------------------------------------------------------
  // Identity
  // ---------------------------------------------------------------------------

  identityId String @unique

  identity Identity @relation("IdentityVerification", fields: [identityId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Verification State
  // ---------------------------------------------------------------------------

  status VerificationStatus
  level  VerificationLevel

  // ---------------------------------------------------------------------------
  // Verification Results
  // ---------------------------------------------------------------------------

  profilePhotoVerified  Boolean @default(false)
  governmentIdVerified  Boolean @default(false)
  driverLicenseVerified Boolean @default(false)

  // ---------------------------------------------------------------------------
  // Verification Timestamps
  // ---------------------------------------------------------------------------

  verifiedAt DateTime?
  expiresAt  DateTime?

  memberVerifiedAt        DateTime?
  driverVerifiedAt        DateTime?
  profilePhotoVerifiedAt  DateTime?
  governmentIdVerifiedAt  DateTime?
  driverLicenseVerifiedAt DateTime?

  // ---------------------------------------------------------------------------
  // Review
  // ---------------------------------------------------------------------------

  reviewedById String?

  reviewedBy Identity? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason String?
  lastReviewedAt  DateTime?

  // ---------------------------------------------------------------------------
  // Requests
  // ---------------------------------------------------------------------------

  requests VerificationRequest[]

  // ---------------------------------------------------------------------------
  // Timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([reviewedById])
  @@index([status])
  @@index([level])
  @@index([expiresAt])
  @@map("verifications")
}

// =============================================================================
// VERIFICATION REQUEST
// =============================================================================

model VerificationRequest {
  id       String @id @default(uuid())
  publicId String @unique

  // ---------------------------------------------------------------------------
  // Verification
  // ---------------------------------------------------------------------------

  verificationId String

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Requested Verification
  // ---------------------------------------------------------------------------

  type   VerificationRequestType
  status VerificationRequestStatus

  // ---------------------------------------------------------------------------
  // Asset
  // ---------------------------------------------------------------------------

  assetId String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // ---------------------------------------------------------------------------
  // Submission
  // ---------------------------------------------------------------------------

  submittedAt DateTime @default(now())

  // ---------------------------------------------------------------------------
  // Review
  // ---------------------------------------------------------------------------

  reviewedAt DateTime?

  reviewedById String?

  reviewedBy Identity? @relation("VerificationRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason String?

  // ---------------------------------------------------------------------------
  // Metadata
  // ---------------------------------------------------------------------------

  metadata Json?

  // ---------------------------------------------------------------------------
  // Timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([verificationId])
  @@index([assetId])
  @@index([type])
  @@index([status])
  @@index([reviewedById])
  @@map("verification_requests")
}

// =============================================================================
// ROLE
// =============================================================================

model Role {
  id       String @id @default(uuid())
  publicId String @unique

  name String @unique
  code String @unique

  description  String?
  displayOrder Int     @default(0)

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  // ---------------------------------------------------------------------------
  // Relationships
  // ---------------------------------------------------------------------------

  identityRoles IdentityRole[]

  rolePermissions RolePermission[]

  // ---------------------------------------------------------------------------
  // Timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([code])
  @@index([isActive])
  @@map("roles")
}

// =============================================================================
// IDENTITY ROLE
// =============================================================================

model IdentityRole {
  id       String @id @default(uuid())
  publicId String @unique

  // ---------------------------------------------------------------------------
  // Identity
  // ---------------------------------------------------------------------------

  identityId String

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Role
  // ---------------------------------------------------------------------------

  roleId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // ---------------------------------------------------------------------------
  // Assignment
  // ---------------------------------------------------------------------------

  assignedById String?

  assignedBy Identity? @relation("RoleAssignments", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now())

  expiresAt DateTime?

  // ---------------------------------------------------------------------------
  // Revocation
  // ---------------------------------------------------------------------------

  revokedAt DateTime?

  revokedById String?

  revokedBy Identity? @relation("RoleRevocations", fields: [revokedById], references: [id], onDelete: SetNull)

  // ---------------------------------------------------------------------------
  // Timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Constraints / Indexes
  // ---------------------------------------------------------------------------

  @@index([identityId])
  @@index([roleId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("identity_roles")
}

// =============================================================================
// PERMISSION
// =============================================================================

model Permission {
  id       String @id @default(uuid())
  publicId String @unique

  name String
  code String @unique

  resource String
  action   String

  description String?

  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  // ---------------------------------------------------------------------------
  // Relationships
  // ---------------------------------------------------------------------------

  rolePermissions RolePermission[]

  // ---------------------------------------------------------------------------
  // Timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Constraints / Indexes
  // ---------------------------------------------------------------------------

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
  @@index([isActive])
  @@map("permissions")
}

// =============================================================================
// ROLE PERMISSION
// =============================================================================

model RolePermission {
  id       String @id @default(uuid())
  publicId String @unique

  // ---------------------------------------------------------------------------
  // Role
  // ---------------------------------------------------------------------------

  roleId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Permission
  // ---------------------------------------------------------------------------

  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Constraints / Indexes
  // ---------------------------------------------------------------------------

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// AUTH DOMAIN
// =============================================================================

model Authentication {
  id       String @id @default(uuid())
  publicId String @unique

  // Opaque cross-domain reference to Identity.
  identityPublicId String @unique

  status AuthenticationStatus

  passwordHash    String?
  passwordVersion Int     @default(1)

  passwordChangedAt  DateTime?
  passwordMustChange Boolean   @default(false)

  failedAuthenticationCount  Int       @default(0)
  lastFailedAuthenticationAt DateTime?

  lockedAt    DateTime?
  lockedUntil DateTime?
  lockReason  AuthenticationFailureReason?

  lastAuthenticatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lockedUntil])
  @@index([lastAuthenticatedAt])
  @@map("authentications")
}

// =============================================================================
// SESSION
// =============================================================================

model Session {
  id       String @id @default(uuid())
  publicId String @unique

  // Opaque cross-domain reference.
  identityPublicId String

  // Opaque reference to a Device aggregate.
  devicePublicId String?

  status SessionStatus

  // Only the hash is persisted.
  refreshTokenHash String @unique

  // Supports refresh-token rotation and token-family revocation.
  tokenFamilyPublicId       String
  replacedBySessionPublicId String?

  ipAddress   String?
  userAgent   String?
  countryCode String? @db.VarChar(2)
  city        String?

  authenticatedAt DateTime
  lastActivityAt  DateTime
  expiresAt       DateTime

  revokedAt     DateTime?
  revokedReason SessionRevocationReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identityPublicId])
  @@index([devicePublicId])
  @@index([tokenFamilyPublicId])
  @@index([status])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("sessions")
}

// =============================================================================
// DEVICE
// =============================================================================

model Device {
  id       String @id @default(uuid())
  publicId String @unique

  // Opaque cross-domain reference.
  identityPublicId String

  status     DeviceStatus
  trustLevel DeviceTrustLevel

  fingerprint String

  name                   String?
  platform               String?
  operatingSystem        String?
  operatingSystemVersion String?
  browser                String?
  browserVersion         String?

  deviceType DeviceType

  trustedAt  DateTime?
  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identityPublicId, fingerprint])
  @@index([identityPublicId])
  @@index([status])
  @@index([trustLevel])
  @@index([lastSeenAt])
  @@map("devices")
}

// =============================================================================
// RECOVERY
// =============================================================================

model Recovery {
  id       String @id @default(uuid())
  publicId String @unique

  // Opaque cross-domain reference.
  identityPublicId String

  type   RecoveryType
  status RecoveryStatus

  // Only the hash is persisted.
  recoveryTokenHash String? @unique

  requestedAt DateTime
  expiresAt   DateTime

  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identityPublicId])
  @@index([expiresAt])
  @@index([requestedAt])
  @@index([identityPublicId, type])
  @@index([identityPublicId, status])
  @@map("recoveries")
}

// =============================================================================
// OTP CHALLENGE
// =============================================================================

model OtpChallenge {
  id       String @id @default(uuid())
  publicId String @unique

  // ---------------------------------------------------------------------------
  // Identity
  // ---------------------------------------------------------------------------

  // Opaque cross-domain reference to the Identity.
  //
  // Intentionally NOT a Prisma relation.
  identityPublicId String

  // ---------------------------------------------------------------------------
  // Challenge
  // ---------------------------------------------------------------------------

  // Business purpose of the OTP Challenge.
  purpose OtpPurpose

  // Current OTP Challenge lifecycle status.
  status OtpStatus

  // Snapshot of the destination challenged when the OTP was issued.
  destination String

  // Persisted OTP hash.
  //
  // Plaintext OTP values are never persisted.
  otpHash String

  // ---------------------------------------------------------------------------
  // Verification
  // ---------------------------------------------------------------------------

  // Number of verification attempts already consumed.
  attempts Int @default(0)

  // Maximum permitted verification attempts.
  maxAttempts Int @default(5)

  // ---------------------------------------------------------------------------
  // Lifecycle
  // ---------------------------------------------------------------------------

  // Challenge expiration timestamp.
  expiresAt DateTime

  // Timestamp at which the Challenge was successfully verified.
  //
  // NULL until status becomes VERIFIED.
  verifiedAt DateTime?

  // ---------------------------------------------------------------------------
  // Audit
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([identityPublicId])
  @@index([identityPublicId, purpose])
  @@index([status])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// =============================================================================
// ASSET
// =============================================================================
//
// Asset represents a stored file owned by an identity and referenced by
// application domains.
//
// Examples:
// - profile photo
// - government ID
// - driver's licence
// - passport
// - vehicle photo
// - chat attachment
//
// Public API uses Asset.publicId.
// Internal relationships use Asset.id.
//
// Ownership is established by the authenticated identity. Clients must not
// be trusted to assign an asset to another identity.
//
// =============================================================================

model Asset {
  id       String @id @default(uuid())
  publicId String @unique

  // ---------------------------------------------------------------------------
  // Ownership
  // ---------------------------------------------------------------------------

  ownerIdentityId String?
  ownerIdentity   Identity? @relation(fields: [ownerIdentityId], references: [id], onDelete: SetNull)

  // ---------------------------------------------------------------------------
  // Classification
  // ---------------------------------------------------------------------------

  type     AssetType
  category AssetCategory

  // ---------------------------------------------------------------------------
  // Lifecycle
  // ---------------------------------------------------------------------------

  status     AssetStatus     @default(UPLOADING)
  visibility AssetVisibility @default(PRIVATE)

  // ---------------------------------------------------------------------------
  // Storage
  // ---------------------------------------------------------------------------

  storageProvider StorageProvider

  bucket    String
  objectKey String @unique

  // ---------------------------------------------------------------------------
  // File Metadata
  // ---------------------------------------------------------------------------

  originalFilename String?
  mimeType         String
  sizeBytes        BigInt

  // ---------------------------------------------------------------------------
  // Lifecycle Timestamps
  // ---------------------------------------------------------------------------

  uploadedAt DateTime?
  archivedAt DateTime?
  deletedAt  DateTime?

  // ---------------------------------------------------------------------------
  // Domain References
  // ---------------------------------------------------------------------------

  verificationRequests VerificationRequest[]

  // ---------------------------------------------------------------------------
  // Audit
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([ownerIdentityId])
  @@index([type])
  @@index([category])
  @@index([status])
  @@index([visibility])
  @@index([storageProvider])
  @@index([ownerIdentityId, status])
  @@index([ownerIdentityId, category])
  @@index([type, status])
  @@index([category, status])
  @@index([visibility, status])
  @@map("assets")
}

// ============================================================
// TRAVELLER PROFILE
// ============================================================

model TravellerProfile {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Cross-domain reference
  // ---------------------------------------------------------------------------

  /// References Identity.publicId.
  /// This is intentionally NOT a Prisma relation.
  memberPublicId String @unique

  // ---------------------------------------------------------------------------
  // Traveller identity
  // ---------------------------------------------------------------------------

  /// Public traveller handle.
  /// Example: john_doe
  handle String @unique

  bio String?

  // ---------------------------------------------------------------------------
  // Cross-domain asset reference
  // ---------------------------------------------------------------------------

  /// References Asset.publicId.
  /// This is intentionally NOT a Prisma relation.
  avatarAssetPublicId String?

  // ---------------------------------------------------------------------------
  // Traveller location
  // ---------------------------------------------------------------------------

  /// ISO 3166-1 alpha-2 country code.
  /// Example: KE, UG, TZ.
  countryCode String @default("KE")

  // ---------------------------------------------------------------------------
  // Profile lifecycle
  // ---------------------------------------------------------------------------

  status     TravellerProfileStatus     @default(ACTIVE)
  visibility TravellerProfileVisibility @default(PUBLIC)

  // ---------------------------------------------------------------------------
  // Materialized journey statistics
  //
  // Journey domain remains authoritative.
  // These values are projections maintained from journey events.
  // ---------------------------------------------------------------------------

  totalJourneys     Int @default(0)
  completedJourneys Int @default(0)

  providerJourneys  Int @default(0)
  passengerJourneys Int @default(0)

  completedProviderJourneys  Int @default(0)
  completedPassengerJourneys Int @default(0)

  // ---------------------------------------------------------------------------
  // Traveller profile components
  // ---------------------------------------------------------------------------

  preferences TravellerProfilePreferences?

  corridors TravellerProfileCorridor[]

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([memberPublicId])
  @@index([status])
  @@index([visibility])
  @@index([countryCode])
  @@index([handle])
  @@index([avatarAssetPublicId])
  @@map("traveller_profiles")
}

// ============================================================
// TRAVELLER PROFILE PREFERENCES
// ============================================================

model TravellerProfilePreferences {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  profileId String @unique

  profile TravellerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  showJourneyHistory    Boolean @default(true)
  showJourneyStatistics Boolean @default(true)
  allowJourneyInvites   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("traveller_profile_preferences")
}

// ============================================================
// FREQUENT TRAVEL CORRIDOR
// ============================================================

model TravellerProfileCorridor {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  profileId String

  profile TravellerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Human-readable corridor information
  // ---------------------------------------------------------------------------

  originName      String
  destinationName String

  // ---------------------------------------------------------------------------
  // Geographic discovery coordinates
  // ---------------------------------------------------------------------------

  originLatitude  Decimal @db.Decimal(10, 7)
  originLongitude Decimal @db.Decimal(10, 7)

  destinationLatitude  Decimal @db.Decimal(10, 7)
  destinationLongitude Decimal @db.Decimal(10, 7)

  // ---------------------------------------------------------------------------
  // Stable discovery/matching identifier
  //
  // This is NOT a foreign key to Journey.
  // ---------------------------------------------------------------------------

  corridorKey String?

  // ---------------------------------------------------------------------------
  // Primary corridor
  // ---------------------------------------------------------------------------

  isPrimary Boolean @default(false)

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([profileId])
  @@index([profileId, isPrimary])
  @@index([corridorKey])
  @@index([originLatitude, originLongitude])
  @@index([destinationLatitude, destinationLongitude])
  @@map("traveller_profile_corridors")
}

// ============================================================
// TRUST PROFILE
// ============================================================

model TrustProfile {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Cross-domain reference
  // ---------------------------------------------------------------------------

  /// References Identity.publicId.
  /// Intentionally NOT a Prisma relation.
  memberPublicId String @unique

  // ---------------------------------------------------------------------------
  // Trust state
  // ---------------------------------------------------------------------------

  status            TrustProfileStatus     @default(ACTIVE)
  verificationLevel TrustVerificationLevel @default(NONE)

  // ---------------------------------------------------------------------------
  // Rating statistics
  // ---------------------------------------------------------------------------

  ratingAverage Decimal @default(0) @db.Decimal(3, 2)
  ratingCount   Int     @default(0)

  // ---------------------------------------------------------------------------
  // Journey statistics
  //
  // Journey remains authoritative.
  // These values are materialized trust projections.
  // ---------------------------------------------------------------------------

  completedJourneys Int @default(0)
  providerJourneys  Int @default(0)
  passengerJourneys Int @default(0)

  completedProviderJourneys  Int @default(0)
  completedPassengerJourneys Int @default(0)

  cancelledJourneys      Int @default(0)
  providerCancellations  Int @default(0)
  passengerCancellations Int @default(0)

  completionRate   Decimal @default(0) @db.Decimal(5, 2)
  cancellationRate Decimal @default(0) @db.Decimal(5, 2)

  // ---------------------------------------------------------------------------
  // Trust components
  // ---------------------------------------------------------------------------

  ratings TrustRating[]

  badges TrustProfileBadge[]

  events TrustEvent[]

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([memberPublicId])
  @@index([status])
  @@index([verificationLevel])
  @@index([ratingAverage])
  @@index([completedJourneys])
  @@index([completionRate])
  @@map("trust_profiles")
}

model TrustRating {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Internal Trust-domain relation
  // ---------------------------------------------------------------------------

  profileId String

  profile TrustProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Cross-domain references
  // ---------------------------------------------------------------------------

  /// Identity.publicId of the reviewer.
  reviewerPublicId String

  /// Identity.publicId of the person being reviewed.
  revieweePublicId String

  /// Journey.publicId.
  journeyPublicId String

  /// Booking.publicId.
  bookingPublicId String?

  // ---------------------------------------------------------------------------
  // Rating
  // ---------------------------------------------------------------------------

  role  TrustRatingRole @default(PASSENGER)
  score Int

  status TrustRatingStatus @default(ACTIVE)

  // ---------------------------------------------------------------------------
  // Review
  // ---------------------------------------------------------------------------

  review TrustReview?

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Constraints / indexes
  // ---------------------------------------------------------------------------

  @@unique([journeyPublicId, reviewerPublicId, revieweePublicId])
  @@index([profileId])
  @@index([reviewerPublicId])
  @@index([revieweePublicId])
  @@index([journeyPublicId])
  @@index([bookingPublicId])
  @@index([status])
  @@index([score])
  @@index([revieweePublicId, status])
  @@map("trust_ratings")
}

// ============================================================
// TRUST REVIEW
// ============================================================

model TrustReview {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Internal Trust-domain relation
  // ---------------------------------------------------------------------------

  ratingId String @unique

  rating TrustRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Review content
  // ---------------------------------------------------------------------------

  content String

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trust_reviews")
}

model TrustBadge {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  type TrustBadgeType @unique

  name        String
  description String?

  // ---------------------------------------------------------------------------
  // Cross-domain Asset reference
  // ---------------------------------------------------------------------------

  /// References Asset.publicId.
  /// Intentionally NOT a Prisma relation.
  assetPublicId String?

  active Boolean @default(true)

  profiles TrustProfileBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([assetPublicId])
  @@map("trust_badges")
}

// ============================================================
// TRUST PROFILE BADGE
// ============================================================

model TrustProfileBadge {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Internal Trust-domain relation
  // ---------------------------------------------------------------------------

  profileId String

  profile TrustProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  badgeId String

  badge TrustBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Award lifecycle
  // ---------------------------------------------------------------------------

  awardedAt DateTime  @default(now())
  revokedAt DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Constraints / indexes
  // ---------------------------------------------------------------------------

  @@unique([profileId, badgeId])
  @@index([profileId])
  @@index([badgeId])
  @@index([profileId, active])
  @@index([badgeId, active])
  @@map("trust_profile_badges")
}

model TrustEvent {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Internal Trust-domain relation
  // ---------------------------------------------------------------------------

  profileId String

  profile TrustProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Event
  // ---------------------------------------------------------------------------

  type TrustEventType

  // ---------------------------------------------------------------------------
  // Cross-domain references
  //
  // These intentionally remain scalar public IDs.
  // ---------------------------------------------------------------------------

  /// Journey.publicId
  journeyPublicId String?

  /// Booking.publicId
  bookingPublicId String?

  /// TrustRating.publicId
  ratingPublicId String?

  /// TrustBadge.publicId
  badgePublicId String?

  /// Dispute.publicId
  disputePublicId String?

  /// Identity.publicId of actor.
  actorPublicId String?

  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([profileId])
  @@index([type])
  @@index([profileId, createdAt])
  @@index([journeyPublicId])
  @@index([bookingPublicId])
  @@index([ratingPublicId])
  @@index([badgePublicId])
  @@index([disputePublicId])
  @@index([actorPublicId])
  @@map("trust_events")
}

// ============================================================
// JOURNEY DOMAIN
// ============================================================

model Journey {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Cross-domain reference
  // ---------------------------------------------------------------------------

  /// References Identity.publicId.
  /// Intentionally NOT a Prisma relation.
  providerPublicId String

  // ---------------------------------------------------------------------------
  // Lifecycle
  // ---------------------------------------------------------------------------

  status JourneyStatus @default(DRAFT)

  publishedAt           DateTime?
  startedAt             DateTime?
  completionRequestedAt DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  expiredAt             DateTime?

  version Int @default(1)

  // ---------------------------------------------------------------------------
  // Journey components
  // ---------------------------------------------------------------------------

  corridor JourneyCorridor?
  schedule JourneySchedule?

  vehicleId String?
  vehicle   JourneyVehicle? @relation(fields: [vehicleId], references: [id])

  capacity    JourneyCapacity?
  pricing     JourneyPricing?
  preferences JourneyPreferences?

  assets   JourneyAsset[]
  boarding JourneyBoarding?

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
