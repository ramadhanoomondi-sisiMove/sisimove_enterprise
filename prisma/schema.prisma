// JOURNEY BOOKING PRICING
// ============================================================

model JourneyBookingPricing {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Internal Booking relation
  // ---------------------------------------------------------------------------

  bookingId String @unique

  booking JourneyBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Pricing snapshot
  // ---------------------------------------------------------------------------

  pricePerSeat Int
  seats        Int

  subtotal         Int
  discountAmount   Int @default(0)
  adjustmentAmount Int @default(0)

  totalAmount Int

  currency String @default("KES")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("journey_booking_pricing")
}

// ============================================================
// JOURNEY BOOKING PAYMENT
// ============================================================

model JourneyBookingPayment {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Internal Booking relation
  // ---------------------------------------------------------------------------

  bookingId String @unique

  booking JourneyBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Payment state
  // ---------------------------------------------------------------------------

  status JourneyBookingPaymentStatus @default(PENDING)

  /// Final amount payable by the passenger.
  ///
  /// This amount includes all commercial amounts assessed for the booking
  /// that are applicable to the passenger payment.
  ///
  /// Example:
  ///
  /// JourneyBookingPricing.subtotal = 1000
  /// Commercial booking commission = 50
  /// JourneyBookingPayment.amount = 1050
  amount Int

  currency String @default("KES")

  // ---------------------------------------------------------------------------
  // Cross-domain transaction reference
  // ---------------------------------------------------------------------------

  /// References the Financial/Payment transaction domain.
  /// Intentionally NOT a Prisma relation.
  transactionPublicId String?

  // ---------------------------------------------------------------------------
  // Payment lifecycle
  // ---------------------------------------------------------------------------

  authorizedAt DateTime?
  capturedAt   DateTime?
  failedAt     DateTime?
  refundedAt   DateTime?

  failureReason String?

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([status])
  @@index([transactionPublicId])
  @@index([capturedAt])
  @@map("journey_booking_payments")
}

