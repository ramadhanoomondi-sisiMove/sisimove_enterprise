// ============================================================
// SUPPORT CASE
// ============================================================

model SupportCase {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Cross-domain Identity reference
  // ---------------------------------------------------------------------------

  /// References Identity.publicId.
  /// Intentionally NOT a Prisma relation.
  requesterPublicId String

  // ---------------------------------------------------------------------------
  // Case
  // ---------------------------------------------------------------------------

  status   SupportCaseStatus   @default(OPEN)
  priority SupportCasePriority @default(NORMAL)
  category SupportCaseCategory

  subject     String
  description String?

  // ---------------------------------------------------------------------------
  // Cross-domain reference
  // ---------------------------------------------------------------------------

  /// Identifies the resource this support case concerns.
  ///
  /// Examples:
  /// - Journey
  /// - JourneyBooking
  /// - JourneyCompletion
  /// - JourneyCompletionDispute
  /// - FinancialPayment
  /// - FinancialAccount
  /// - TrustProfile
  ///
  /// Intentionally NOT a Prisma relation.
  referenceType     String?
  referencePublicId String?

  // ---------------------------------------------------------------------------
  // Assignment
  // ---------------------------------------------------------------------------

  /// References Identity.publicId.
  /// Intentionally NOT a Prisma relation.
  assignedToPublicId String?

  // ---------------------------------------------------------------------------
  // Case children
  // ---------------------------------------------------------------------------

  messages     SupportCaseMessage[]
  participants SupportCaseParticipant[]
  notes        SupportCaseNote[]
  evidence     SupportCaseEvidence[]
  resolution   SupportCaseResolution?

  // ---------------------------------------------------------------------------
  // Lifecycle
  // ---------------------------------------------------------------------------

  openedAt    DateTime  @default(now())
  resolvedAt  DateTime?
  closedAt    DateTime?
  cancelledAt DateTime?

  // ---------------------------------------------------------------------------
  // Optimistic concurrency
  // ---------------------------------------------------------------------------

  version Int @default(1)

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([requesterPublicId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedToPublicId])
  @@index([referenceType, referencePublicId])
  @@index([status, priority])
  @@index([status, createdAt])
  @@map("support_cases")
}

