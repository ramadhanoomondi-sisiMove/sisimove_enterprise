// ============================================================
// FINANCIAL ACCOUNT
// ============================================================

model FinancialAccount {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  type    FinancialAccountType
  purpose FinancialAccountPurpose

  ownerPublicId String?

  currency String @default("KES")

  availableBalance Int @default(0)
  pendingBalance   Int @default(0)

  status FinancialAccountStatus @default(ACTIVE)

  version Int @default(1)

  identity  Identity?
  entries   FinancialAccountEntry[]
  wallet    FinancialWallet?
  moneyIns  FinancialMoneyIn[]
  moneyOuts FinancialMoneyOut[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerPublicId])
  @@index([type])
  @@index([purpose])
  @@index([status])
  @@index([ownerPublicId, purpose])
}

// ============================================================
// ACCOUNT ENTRY
// ============================================================

model FinancialAccountEntry {
  id String @id @default(uuid())

  publicId String @unique @default(uuid())

  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  transactionId String
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id])

  direction     FinancialEntryDirection
  balanceBucket FinancialBalanceBucket

  amount   Int
  currency String @default("KES")

  balanceAfter Int

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([transactionId])
  @@index([accountId, createdAt])
  @@index([accountId, balanceBucket, createdAt])
}

// ============================================================
// FINANCIAL TRANSACTION
// ============================================================

model FinancialTransaction {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  type   FinancialTransactionType
  status FinancialTransactionStatus @default(PENDING)

  amount   Int
  currency String @default("KES")

  referenceType     String?
  referencePublicId String?

  externalReference String?

  idempotencyKey String? @unique

  description String?

  entries FinancialAccountEntry[]

  moneyIn  FinancialMoneyIn?
  moneyOut FinancialMoneyOut?

  completedAt DateTime?
  failedAt    DateTime?
  reversedAt  DateTime?
  cancelledAt DateTime?

  failureReason String?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([referenceType, referencePublicId])
  @@index([externalReference])
  @@index([status, createdAt])
}

// ============================================================
// USER WALLET
// ============================================================

model FinancialWallet {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  accountId String           @unique
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
