// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Cross-domain Identity reference
  // ---------------------------------------------------------------------------

  /// References Identity.publicId.
  /// Intentionally NOT a Prisma relation.
  recipientPublicId String

  // ---------------------------------------------------------------------------
  // Notification
  // ---------------------------------------------------------------------------

  type     NotificationType
  priority NotificationPriority @default(NORMAL)
  status   NotificationStatus   @default(PENDING)

  title String
  body  String

  // ---------------------------------------------------------------------------
  // Cross-domain reference
  // ---------------------------------------------------------------------------

  /// Generic reference to the domain resource that caused the notification.
  ///
  /// Examples:
  /// - Journey
  /// - JourneyBooking
  /// - JourneyCompletion
  /// - JourneyCompletionDispute
  /// - FinancialPayment
  /// - SupportCase
  ///
  /// Intentionally NOT a Prisma relation.
  referenceType     String?
  referencePublicId String?

  // ---------------------------------------------------------------------------
  // Source event
  // ---------------------------------------------------------------------------

  /// Event that caused this notification.
  ///
  /// Intentionally stored as scalar metadata rather than a Prisma relation.
  eventType     String?
  eventPublicId String?

  // ---------------------------------------------------------------------------
  // Delivery lifecycle
  // ---------------------------------------------------------------------------

  sentAt      DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  failureReason String?

  // ---------------------------------------------------------------------------
  // Deliveries
  // ---------------------------------------------------------------------------

  deliveries NotificationDelivery[]

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Indexes
  // ---------------------------------------------------------------------------

  @@index([recipientPublicId])
  @@index([recipientPublicId, status])
  @@index([recipientPublicId, createdAt])
  @@index([type])
  @@index([priority])
  @@index([eventType, eventPublicId])
  @@index([referenceType, referencePublicId])
  @@map("notifications")
}

// ============================================================
// NOTIFICATION PREFERENCE
// ============================================================

model NotificationPreference {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Cross-domain Identity reference
  // ---------------------------------------------------------------------------

  /// References Identity.publicId.
  /// Exactly one preference aggregate per member.
  /// Intentionally NOT a Prisma relation.
  memberPublicId String @unique

  // ---------------------------------------------------------------------------
  // Notification preferences
  // ---------------------------------------------------------------------------

  journeyEnabled      Boolean @default(true)
  bookingEnabled      Boolean @default(true)
  paymentEnabled      Boolean @default(true)
  walletEnabled       Boolean @default(true)
  trustEnabled        Boolean @default(true)
  verificationEnabled Boolean @default(true)
  messageEnabled      Boolean @default(true)
  supportEnabled      Boolean @default(true)
  systemEnabled       Boolean @default(true)

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ============================================================
// NOTIFICATION DELIVERY
// ============================================================

model NotificationDelivery {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // ---------------------------------------------------------------------------
  // Internal Message-domain relation
  // ---------------------------------------------------------------------------

  notificationId String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------------
  // Delivery
  // ---------------------------------------------------------------------------

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(PENDING)

  providerReference String?

  // ---------------------------------------------------------------------------
  // Delivery lifecycle
  // ---------------------------------------------------------------------------

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  failureReason String?

  // ---------------------------------------------------------------------------
  // Audit timestamps
  // ---------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------------------------
  // Constraints / indexes
  // ---------------------------------------------------------------------------

  @@unique([notificationId, channel])
  @@index([notificationId])
  @@index([status])
  @@index([channel, status])
  @@map("notification_deliveries")
}

